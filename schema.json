{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Chaos Ray Tracing scene",
  "type": "object",
  "required": [
    "settings",
    "camera",
    "materials",
    "objects",
    "textures"
  ],
  "properties": {
    "settings": {
      "type": "object",
      "required": [
        "background_color",
        "image_settings"
      ],
      "properties": {
        "background_color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "image_settings": {
          "type": "object",
          "required": [
            "width",
            "height",
            "bucket_size"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "bucket_size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "matrix",
        "position"
      ],
      "properties": {
        "matrix": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "number"
          }
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "textures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "albedo",
              "edges",
              "checker",
              "bitmap"
            ]
          },
          "albedo": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "edge_color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "inner_color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "color_A": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "color_B": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "edge_width": {
            "type": "number",
            "minimum": 0
          },
          "square_size": {
            "type": "number",
            "minimum": 0
          },
          "file_path": {
            "type": "string"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "smooth_shading"
        ],
        "properties": {
          "type": {
            "enum": [
              "diffuse",
              "reflective",
              "refractive",
              "constant"
            ]
          },
          "albedo": {
            "type": "string"
          },
          "smooth_shading": {
            "type": "boolean"
          },
          "ior": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "material_index",
          "vertices",
          "triangles",
          "uvs"
        ],
        "properties": {
          "material_index": {
            "type": "integer",
            "minimum": 0
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "number"
            }
          },
          "triangles": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "uvs":{
            "type":"array",
            "minItems": 3,
            "items": {
              "type":"number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "intensity"
        ],
        "properties": {
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "intensity": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}